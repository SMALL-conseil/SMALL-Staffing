# ============================================================
#  Variables PROPRES À L'OUTIL — à copier en small-app.env sur le VPS :
#      cp small-app.env.example small-app.env   (dans /opt/small/deploy)
#  Lu APRÈS le .env central (partagé) par les services small-app*.
#  NE JAMAIS committer small-app.env.
# ============================================================

# Base dédiée de l'outil (instance PostgreSQL partagée du VPS).
# Créer la base d'abord — cf. SETUP.md. Même mot de passe que POSTGRES_PASSWORD.
DATABASE_URL=postgresql://CHANGEME_user:CHANGEME_mdp@postgres:5432/small_app?schema=public

# URL publique de la prod
NEXTAUTH_URL=https://small-app.small-conseil.com
AUTH_TRUST_HOST=true

# Secret de session (générer : openssl rand -base64 32)
AUTH_SECRET=CHANGEME_openssl_rand_base64_32

# SSO Microsoft Entra ID — optionnel : vide = bouton Microsoft inactif.
# Créer une app Entra dédiée à l'outil (URI de redirection prod + préprod).
AUTH_MICROSOFT_ENTRA_ID_CLIENT_ID=
AUTH_MICROSOFT_ENTRA_ID_CLIENT_SECRET=
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=

# SMTP Office 365 — SMTP_FROM = MÊME adresse que SMTP_USER, chevron > final !
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM='SMALL App <small-app@small-conseil.com>'
