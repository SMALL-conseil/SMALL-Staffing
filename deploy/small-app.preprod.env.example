# ============================================================
#  Surcharges PRÉPROD de l'outil — à copier en small-app.preprod.env (VPS) :
#      cp small-app.preprod.env.example small-app.preprod.env
#  Lu APRÈS .env central PUIS small-app.env : seules les valeurs qui
#  DIFFÈRENT de la prod sont listées ici. NE JAMAIS committer.
# ============================================================

# Base SÉPARÉE de la préprod (copie de la prod à la demande — cf. SETUP.md)
DATABASE_URL=postgresql://CHANGEME_user:CHANGEME_mdp@postgres:5432/small_app_preprod?schema=public

# URL publique de la préprod
NEXTAUTH_URL=https://small-app-preprod.small-conseil.com

# Secret de session distinct de la prod
AUTH_SECRET=CHANGEME_autre_secret

# Emails NEUTRALISÉS en préprod : valeurs vides => envois « simulés » dans les
# logs du conteneur (mécanisme d'étanchéité standard — à conserver).
SMTP_USER=
SMTP_PASS=
