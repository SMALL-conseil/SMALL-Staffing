# ============================================================
#  Environnement de DEV LOCAL — copier en .env :  cp .env.example .env
#  (le .env est ignoré par git)
# ============================================================

# PostgreSQL local (cf. README : winget install PostgreSQL.PostgreSQL.16,
# puis CREATE DATABASE staffing;)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/staffing?schema=public"

# Secret de session JWT (générer : openssl rand -base64 32)
AUTH_SECRET="dev-secret-a-changer"
# NEXTAUTH_URL : laisser vide en dev (port deduit de la requete via trustHost) ; en prod, pose par les env du VPS
AUTH_TRUST_HOST=true

# SSO Microsoft Entra ID — optionnel, vide = bouton Microsoft inactif en local
AUTH_MICROSOFT_ENTRA_ID_CLIENT_ID=""
AUTH_MICROSOFT_ENTRA_ID_CLIENT_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=""

# SMTP — vide en local : les emails sont « simulés » dans la console
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SMALL Staffing <staffing@small-conseil.com>"

# Secret des routes planifiées (cron VPS) — générer : openssl rand -hex 24
CRON_SECRET=""

# Synchro BoondManager (registre des personnes) — mêmes tokens que Formation.
# Vide en local = boutons de synchro inactifs (l'app fonctionne sans).
BOOND_USER_TOKEN=""
BOOND_CLIENT_TOKEN=""
BOOND_CLIENT_KEY=""
# À FIGER après `npx tsx scripts/boond-inspect.ts` (relevé du tenant) :
# BOOND_TITLE_FIELD=""        # champ du « Titre » (sinon: title/function/fonction/jobTitle)
# BOOND_ARRIVAL_FIELD=""      # champ date d'arrivée (sinon: startDate/entryDate/…)
# BOOND_DEPARTURE_FIELD=""    # champ date de départ (sinon: endDate/exitDate/…)
# BOOND_ACTIVE_STATES=""      # ex. "1,2,3" (1=à venir, 2=IC, 3=en mission)
# BOOND_INDEP_TYPEOF=""       # codes typeOf des indépendants (grade forcé « Indép »)
# BOOND_EXCLUDED_TYPEOF=""    # codes typeOf à exclure totalement
# BOOND_PREFERRED_EMAIL_DOMAIN="small-conseil.com"
# Jours de CRA (/times, a12) — fenêtre incrémentale et garde-fous :
# BOOND_TIMES_LOOKBACK_DAYS="90"   # profondeur relue chaque nuit (corrections de CRA)
# BOOND_TIMES_MAX_PAGES="300"      # plafond de pages par passage
# BOOND_TIMES_INCLUDE="resource,delivery,project"
# Volet financier (taux journaliers, jours vendus — /deliveries) : jeton d'un
# compte qui VOIT les honoraires dans Boond (le jeton standard prend 403).
# Testé par scripts/boond-inspect-deliveries.ts ; clientToken/clientKey inchangés.
# BOOND_FINANCE_USER_TOKEN=""
