# ============================================================
#  Environnement de DEV LOCAL — copier en .env :  cp .env.example .env
#  (le .env est ignoré par git)
# ============================================================

# PostgreSQL local (cf. README : winget install PostgreSQL.PostgreSQL.16,
# puis CREATE DATABASE staffing;)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/staffing?schema=public"

# Secret de session JWT (générer : openssl rand -base64 32)
AUTH_SECRET="dev-secret-a-changer"
# NEXTAUTH_URL : laisser vide en dev (port deduit de la requete via trustHost) ; en prod, pose par les env du VPS
AUTH_TRUST_HOST=true

# SSO Microsoft Entra ID — optionnel, vide = bouton Microsoft inactif en local
AUTH_MICROSOFT_ENTRA_ID_CLIENT_ID=""
AUTH_MICROSOFT_ENTRA_ID_CLIENT_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=""

# SMTP — vide en local : les emails sont « simulés » dans la console
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SMALL Staffing <staffing@small-conseil.com>"
